{
  "name": "haven-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config vitest.config.ts",
    "test:backend": "npm --prefix functions test",
    "test:rules": "node functions/node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --project demo-haven-vault --only firestore,storage \"node --test functions/test/rules.test.mjs\"",
    "check": "tsc -b",
    "test:config": "node --test scripts/config.test.cjs",
    "firebase": "node functions/node_modules/firebase-tools/lib/bin/firebase.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.2.2",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "description": "A self-hosted, single-owner encrypted vault with passkeys and Firebase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/i-am-jyotirmaya/haven-vault.git"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@12.0.0"
}
