rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function liveSession(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.keys().hasAll(['vaultAccess', 'vaultSession'])
        && request.auth.token.vaultAccess == true
        && request.auth.token.vaultSession is string
        && request.auth.token.vaultSession.matches('^[A-Za-z0-9_-]{43}$')
        && sessionValid(uid, request.auth.token.vaultSession);
    }
    function sessionValid(uid, sessionId) {
      let session = get(/databases/$(database)/documents/_vaultSessions/$(sessionId)).data;
      return session.uid == uid && session.revoked == false && session.expiresAt > request.time;
    }
    function legacyWrites(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)/vault/migration)
        && (!exists(/databases/$(database)/documents/users/$(uid)/vault/config)
          || get(/databases/$(database)/documents/users/$(uid)/vault/config).data.version == 1);
    }
    function activeGeneration(uid, generation) {
      let config = get(/databases/$(database)/documents/users/$(uid)/vault/config).data;
      return config.version == 2 && config.generation == generation;
    }
    function staging(uid, generation) {
      let migration = get(/databases/$(database)/documents/users/$(uid)/vault/migration).data;
      return migration.phase == 'staging' && migration.record.generation == generation
        && migration.sessionId == request.auth.token.vaultSession;
    }
    function encrypted(payload) {
      return payload is map
        && payload.keys().hasOnly(['version', 'iv', 'ciphertext'])
        && payload.keys().hasAll(['version', 'iv', 'ciphertext'])
        && payload.version in [1, 2]
        && payload.iv is string && payload.iv.size() == 16
        && payload.iv.matches('^[A-Za-z0-9+/]{16}$')
        && payload.ciphertext is string
        && payload.ciphertext.size() >= 24
        && payload.ciphertext.size() <= 700000
        && payload.ciphertext.matches('^[A-Za-z0-9+/]+={0,2}$');
    }
    function validConfig(data) {
      return data.keys().hasOnly(['version', 'salt', 'iterations', 'verifier'])
        && data.keys().hasAll(['version', 'salt', 'iterations', 'verifier'])
        && data.version == 1
        && data.salt is string && data.salt.size() == 44
        && data.salt.matches('^[A-Za-z0-9+/]{43}=$')
        && data.iterations is int && data.iterations >= 600000 && data.iterations <= 2000000
        && encrypted(data.verifier) && data.verifier.ciphertext.size() <= 512;
    }
    match /users/{uid}/vault/config {
      allow get: if liveSession(uid);
      allow create: if liveSession(uid) && legacyWrites(uid) && validConfig(request.resource.data);
      // Changing this without re-encrypting every object would lose the vault.
      allow update, delete, list: if false;
    }
    match /users/{uid}/items/{itemId} {
      allow read: if liveSession(uid);
      allow write: if false;
    }
    match /users/{uid}/generations/{generation}/items/{itemId} {
      allow read: if liveSession(uid) && (activeGeneration(uid, generation) || staging(uid, generation)
        || get(/databases/$(database)/documents/users/$(uid)/vault/migration).data.record.generation == generation);
      // Migration creates immutable records in its inactive generation only.
      allow create: if liveSession(uid) && staging(uid, generation)
        && itemId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasOnly(['payload'])
        && encrypted(request.resource.data.payload) && request.resource.data.payload.version == 2;
      allow update, delete: if false;
    }

    // Challenge, credential, owner, session and rate-limit records are Admin SDK only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
