rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function liveSession(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.keys().hasAll(['vaultAccess', 'vaultSession'])
        && request.auth.token.vaultAccess == true
        && request.auth.token.vaultSession is string
        && request.auth.token.vaultSession.matches('^[A-Za-z0-9_-]{43}$')
        && sessionValid(uid, request.auth.token.vaultSession);
    }
    function sessionValid(uid, sessionId) {
      let session = firestore.get(/databases/(default)/documents/_vaultSessions/$(sessionId)).data;
      return session.uid == uid && session.revoked == false && session.expiresAt > request.time;
    }
    function legacyWrites(uid) {
      return !firestore.exists(/databases/(default)/documents/users/$(uid)/vault/migration)
        && (!firestore.exists(/databases/(default)/documents/users/$(uid)/vault/config)
          || firestore.get(/databases/(default)/documents/users/$(uid)/vault/config).data.version == 1);
    }
    function activeGeneration(uid, generation) {
      let config = firestore.get(/databases/(default)/documents/users/$(uid)/vault/config).data;
      return config.version == 2 && config.generation == generation;
    }
    function staging(uid, generation) {
      let migration = firestore.get(/databases/(default)/documents/users/$(uid)/vault/migration).data;
      return migration.phase == 'staging' && migration.record.generation == generation
        && migration.sessionId == request.auth.token.vaultSession;
    }
    match /vaults/{uid}/{itemId} {
      allow get: if liveSession(uid);
      allow delete: if liveSession(uid) && legacyWrites(uid);
      allow create: if resource == null && liveSession(uid) && legacyWrites(uid)
        && itemId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.size >= 29
        && request.resource.size <= 50 * 1024 * 1024 + 29
        && request.resource.contentType == 'application/octet-stream';
      // File objects are immutable; edits create a new randomly named object.
      allow update, list: if false;
    }
    match /generations/{uid}/{generation}/{itemId} {
      allow get: if liveSession(uid) && (activeGeneration(uid, generation) || staging(uid, generation)
        || firestore.get(/databases/(default)/documents/users/$(uid)/vault/migration).data.record.generation == generation);
      allow create: if resource == null && liveSession(uid) && (activeGeneration(uid, generation) || staging(uid, generation))
        && itemId.matches('^[a-f0-9-]{36}$') && request.resource.size >= 29
        && request.resource.size <= 50 * 1024 * 1024 + 29
        && request.resource.contentType == 'application/octet-stream';
      allow delete: if liveSession(uid) && activeGeneration(uid, generation);
      allow update, list: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
