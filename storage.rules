rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function liveSession(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.keys().hasAll(['vaultAccess', 'vaultSession'])
        && request.auth.token.vaultAccess == true
        && request.auth.token.vaultSession is string
        && request.auth.token.vaultSession.matches('^[A-Za-z0-9_-]{43}$')
        && sessionValid(uid, request.auth.token.vaultSession);
    }
    function sessionValid(uid, sessionId) {
      let session = firestore.get(/databases/(default)/documents/_vaultSessions/$(sessionId)).data;
      return session.uid == uid && session.revoked == false && session.expiresAt > request.time;
    }
    // Exactly two Firestore documents per request: the session and this Admin-only
    // generation authority. Storage cannot read a third document in one evaluation.
    function legacyWrites(uid) {
      return !firestore.exists(/databases/(default)/documents/_vaultAccess/$(uid));
    }
    function activeGeneration(uid, generation) {
      return firestore.get(/databases/(default)/documents/_vaultAccess/$(uid)).data.generation == generation;
    }
    function readableGeneration(uid, generation) {
      let authority = firestore.get(/databases/(default)/documents/_vaultAccess/$(uid)).data;
      return authority.generation == generation || authority.migrationGeneration == generation;
    }
    function staging(uid, generation) {
      let authority = firestore.get(/databases/(default)/documents/_vaultAccess/$(uid)).data;
      return authority.migrationPhase == 'staging' && authority.migrationGeneration == generation
        && authority.migrationSessionId == request.auth.token.vaultSession;
    }
    match /vaults/{uid}/{itemId} {
      allow get: if liveSession(uid);
      allow delete: if false;
      allow create: if false && resource == null && liveSession(uid) && legacyWrites(uid)
        && itemId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.size >= 29
        && request.resource.size <= 50 * 1024 * 1024 + 29
        && request.resource.contentType == 'application/octet-stream';
      // File objects are immutable; edits create a new randomly named object.
      allow update, list: if false;
    }
    match /generations/{uid}/{generation}/{itemId} {
      allow get: if liveSession(uid) && readableGeneration(uid, generation);
      allow create: if resource == null && liveSession(uid) && staging(uid, generation)
        && itemId.matches('^[a-f0-9-]{36}$') && request.resource.size >= 29
        && request.resource.size <= 50 * 1024 * 1024 + 29
        && request.resource.contentType == 'application/octet-stream';
      allow delete: if false;
      allow update, list: if false;
    }
    function uploadReceipt(uid, generation, id) {
      return generation == 'legacy'
        ? firestore.get(/databases/(default)/documents/users/$(uid)/operations/$(id)).data
        : firestore.get(/databases/(default)/documents/users/$(uid)/generations/$(generation)/operations/$(id)).data;
    }
    match /staged/{uid}/{generation}/{id} {
      allow get: if liveSession(uid) && uploadReceipt(uid, generation, id).status in ['pending', 'completed'];
      allow create: if resource == null && liveSession(uid)
        && uploadReceipt(uid, generation, id).status == 'pending'
        && uploadReceipt(uid, generation, id).kind == 'upload'
        && request.resource.size == uploadReceipt(uid, generation, id).bytes
        && request.resource.size >= 29 && request.resource.size <= 50 * 1024 * 1024 + 29
        && request.resource.contentType == 'application/octet-stream';
      allow update, delete, list: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
